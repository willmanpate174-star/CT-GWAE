{
  "version": "real9-20261003-v1",
  "datasets": [
    "aucs",
    "dkpol",
    "lazega",
    "noordin",
    "ckm",
    "highschool2013",
    "primaryschool",
    "workplace",
    "uci"
  ],
  "excluded": [
    "twitter_timme"
  ],
  "repeats": 10,
  "threads": 1,
  "device": "cpu",
  "methods": {
    "RDSoS": {
      "tau": "0.1*mean(sum(S,axis=0))",
      "degree_corrected": false,
      "n_init": 100,
      "km_init": "k-means++",
      "km_max_iter": 100,
      "km_tol": 0.0001,
      "eig_which": "LM",
      "eig_tol": 1e-10,
      "eig_maxiter": 10000
    },
    "SCML": {
      "lambda_": 0.5,
      "n_init": 500,
      "km_init": "k-means++",
      "km_max_iter": 100,
      "km_tol": 0.0001,
      "eig_tol": 1e-10,
      "eig_maxiter": 10000
    },
    "WPTTD": {
      "prior_weight": 0.1,
      "regularization": 0.01,
      "max_iter": 200,
      "max_dense_bytes": 2000000000,
      "starts": 1,
      "k_interface": "given_K",
      "louvain_resolution": 1.0,
      "paper_fulltext": "user_supplied_published"
    },
    "DGFM3": {
      "eig_rank": 12,
      "gamma": 1.2,
      "omega": 1.0,
      "dt": 0.4,
      "max_iter": 300,
      "tol": 1e-08,
      "starts": 20,
      "eig_tol": 1e-10,
      "eig_maxiter": 10000,
      "selection": "maximum multiplex modularity",
      "reference_config": "author S2_GT_MP_networks.m default 3sources"
    },
    "jNMF-GCL": {
      "alpha": 3.0,
      "beta": 1.0,
      "gamma": 1.0,
      "positive_neighbors": "floor(N/K)",
      "reduce_dim": 40,
      "epochs": 20,
      "relative_tol": 0.001,
      "eps": 1e-10,
      "adam_lr": 0.001,
      "adam_beta1": 0.9,
      "adam_beta2": 0.999,
      "adam_eps": 1e-08,
      "kmeans_n_init": 10,
      "kmeans_max_iter": 300,
      "kmeans_tol": 0.0001,
      "reference_config": "author realworld default cellphone dimension40; paper weights"
    },
    "DMGI": {
      "nb_epochs": 10000,
      "hid_units": 64,
      "lr": 0.0005,
      "l2_coef": 0.0001,
      "drop_prob": 0.5,
      "reg_coef": 0.001,
      "sc": 3.0,
      "patience": 20,
      "activation": "relu",
      "isSemi": false,
      "isBias": false,
      "isAttn": false,
      "nheads": 1,
      "features": "identity_NxN",
      "kmeans_n_init": 10,
      "kmeans_max_iter": 300,
      "kmeans_tol": 0.0001,
      "dtype": "float32"
    },
    "MultiTensor": {
      "N_real": 50,
      "maxit": 500,
      "tolerance": 0.1,
      "decision": 2,
      "rseed_rule": "base_seed+j",
      "initialization": 0,
      "undirected": true,
      "assortative": false,
      "err": 0.1,
      "err_max": 1e-07,
      "inf": 10000000000000.0,
      "readout": "argmax(u_f)",
      "dtype": "float64"
    }
  }
}